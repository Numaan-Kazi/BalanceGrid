datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  BANK
  CASH
  WALLET
  OTHER
}

enum ExpenseMode {
  SUMMARY
  DETAILED
}

enum WeeklyStatus {
  UNREPORTED
  ZERO_SPENT
  RECORDED
}

enum PlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum BillFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  PAID
  SKIPPED
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String
  username              String?                @unique
  passwordHash          String?
  avatarUrl             String?
  googleId              String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  sessions              Session[]
  accounts              Account[]
  categories            Category[]
  monthlyPeriods        MonthlyPeriod[]
  categoryBudgets       CategoryBudget[]
  weeklyCategoryStates  WeeklyCategoryState[]
  expenses              Expense[]
  incomes               Income[]
  transfers             AccountTransfer[]
  balanceAdjustments    BalanceAdjustment[]
  savingsGoals          SavingsGoal[]
  savingsAllocations    SavingsAllocation[]
  bucketPlans           BucketPlan[]
  recurringBills        RecurringBill[]
  recurringBillPayments RecurringBillPayment[]
  additionalSavings     AdditionalSavings[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                 String              @id @default(uuid())
  userId             String
  name               String
  type               AccountType         @default(BANK)
  openingBalance     Decimal             @default(0.00) @db.Decimal(14, 2)
  openingBalanceDate DateTime            @default(now())
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes            Income[]
  expenses           Expense[]
  transfersFrom      AccountTransfer[]   @relation("TransfersFrom")
  transfersTo        AccountTransfer[]   @relation("TransfersTo")
  balanceAdjustments BalanceAdjustment[]
  savingsAllocations SavingsAllocation[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id                   String                @id @default(uuid())
  userId               String
  name                 String
  icon                 String                @default("tag")
  isDefault            Boolean               @default(false)
  isArchived           Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses             Expense[]
  categoryBudgets      CategoryBudget[]
  weeklyCategoryStates WeeklyCategoryState[]
  recurringBills       RecurringBill[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model MonthlyPeriod {
  id                   String                @id @default(uuid())
  userId               String
  year                 Int
  month                Int // 1 to 12
  overallBudget        Decimal?              @db.Decimal(14, 2)
  startingBalance      Decimal               @default(0.00) @db.Decimal(14, 2)
  isClosed             Boolean               @default(false)
  closedAt             DateTime?
  finalizedSavings     Decimal?              @db.Decimal(14, 2)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryBudgets      CategoryBudget[]
  weeklyCategoryStates WeeklyCategoryState[]
  expenses             Expense[]
  incomes              Income[]
  savingsAllocations   SavingsAllocation[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("monthly_periods")
}

model CategoryBudget {
  id              String        @id @default(uuid())
  userId          String
  monthlyPeriodId String
  categoryId      String
  amount          Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyPeriod   MonthlyPeriod @relation(fields: [monthlyPeriodId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([monthlyPeriodId, categoryId])
  @@index([userId])
  @@map("category_budgets")
}

model WeeklyCategoryState {
  id              String        @id @default(uuid())
  userId          String
  monthlyPeriodId String
  categoryId      String
  weekNumber      Int // 1 to 5
  mode            ExpenseMode   @default(SUMMARY)
  status          WeeklyStatus  @default(UNREPORTED)
  summaryAmount   Decimal       @default(0.00) @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyPeriod   MonthlyPeriod @relation(fields: [monthlyPeriodId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@unique([monthlyPeriodId, categoryId, weekNumber])
  @@index([userId])
  @@map("weekly_category_states")
}

model Expense {
  id                    String                @id @default(uuid())
  userId                String
  accountId             String
  categoryId            String
  monthlyPeriodId       String
  weeklyCategoryStateId String?
  amount                Decimal               @db.Decimal(14, 2)
  refundAmount          Decimal               @default(0.00) @db.Decimal(14, 2)
  date                  DateTime
  weekNumber            Int // 1 to 5
  description           String?
  bucketPlanId          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category              Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  monthlyPeriod         MonthlyPeriod         @relation(fields: [monthlyPeriodId], references: [id], onDelete: Cascade)
  weeklyCategoryState   WeeklyCategoryState?  @relation(fields: [weeklyCategoryStateId], references: [id], onDelete: SetNull)
  bucketPlan            BucketPlan?           @relation(fields: [bucketPlanId], references: [id], onDelete: SetNull)
  recurringBillPayments RecurringBillPayment[]

  @@index([userId, monthlyPeriodId])
  @@index([userId, date])
  @@index([bucketPlanId])
  @@map("expenses")
}

model Income {
  id              String        @id @default(uuid())
  userId          String
  accountId       String
  monthlyPeriodId String
  amount          Decimal       @db.Decimal(14, 2)
  date            DateTime
  source          String
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  monthlyPeriod   MonthlyPeriod @relation(fields: [monthlyPeriodId], references: [id], onDelete: Cascade)

  @@index([userId, monthlyPeriodId])
  @@index([userId, date])
  @@map("incomes")
}

model AccountTransfer {
  id            String   @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("TransfersFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account  @relation("TransfersTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
  @@map("account_transfers")
}

model BalanceAdjustment {
  id        String   @id @default(uuid())
  userId    String
  accountId String
  amount    Decimal  @db.Decimal(14, 2) // positive or negative
  date      DateTime
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId])
  @@map("balance_adjustments")
}

model SavingsGoal {
  id           String              @id @default(uuid())
  userId       String
  name         String
  targetAmount Decimal             @db.Decimal(14, 2)
  targetDate   DateTime?
  notes        String?
  isCompleted  Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations  SavingsAllocation[]

  @@index([userId])
  @@map("savings_goals")
}

model SavingsAllocation {
  id              String        @id @default(uuid())
  userId          String
  savingsGoalId   String
  monthlyPeriodId String
  fromAccountId   String?
  amount          Decimal       @db.Decimal(14, 2)
  date            DateTime
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsGoal     SavingsGoal   @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  monthlyPeriod   MonthlyPeriod @relation(fields: [monthlyPeriodId], references: [id], onDelete: Cascade)
  fromAccount     Account?      @relation(fields: [fromAccountId], references: [id], onDelete: SetNull)

  @@index([userId, savingsGoalId])
  @@index([userId, monthlyPeriodId])
  @@map("savings_allocations")
}

model BucketPlan {
  id          String     @id @default(uuid())
  userId      String
  name        String
  destination String?
  targetYear  Int?
  targetMonth Int?
  budget      Decimal    @db.Decimal(14, 2)
  status      PlanStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@index([userId])
  @@map("bucket_plans")
}

model RecurringBill {
  id          String                 @id @default(uuid())
  userId      String
  name        String
  amount      Decimal                @db.Decimal(14, 2)
  categoryId  String
  frequency   BillFrequency          @default(MONTHLY)
  nextDueDate DateTime
  notes       String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments    RecurringBillPayment[]

  @@index([userId])
  @@map("recurring_bills")
}

model RecurringBillPayment {
  id              String        @id @default(uuid())
  userId          String
  recurringBillId String
  expenseId       String?
  dueDate         DateTime
  paidDate        DateTime?
  amount          Decimal       @db.Decimal(14, 2)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)
  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, recurringBillId])
  @@map("recurring_bill_payments")
}

model AdditionalSavings {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("additional_savings")
}


